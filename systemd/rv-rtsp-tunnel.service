[Unit]
Description=RTSP tunnel to Lightsail go2rtc (bird-view remote view, docs/30)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
# rvnode의 ffmpeg가 rtsp://127.0.0.1:8554/<경로>로 보내면 Cloudflare 터널(ha-lightsail)을 지나 ls의 go2rtc에 닿는다.
# 송출이 없을 때는 연결 없이 로컬 포트만 열어 둔다 (접속이 들어올 때마다 터널 연결을 만든다).
ExecStart=/usr/bin/cloudflared access tcp --hostname caravan-rtsp.nam6411.com --url 127.0.0.1:8554
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
