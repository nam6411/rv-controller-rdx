[Unit]
Description=RV node (BLE devices, GPS, bird-view)
After=network-online.target bluetooth.service
Wants=network-online.target
# 브로커를 이 보드로 옮긴 뒤(docs/29 §5 5단계)에는 mosquitto 뒤에 뜨게 한다:
# After=network-online.target bluetooth.service mosquitto.service

[Service]
Type=simple
User=rvnode
# BLE·GPIO·SPI·I2C·UART·캡처 장치 권한. 그룹 이름은 보드에서 확인 (getent group)
SupplementaryGroups=bluetooth gpio spi i2c dialout video
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rvnode/venv/bin/python -m rvnode -c /etc/rvnode.yaml
WorkingDirectory=/opt/rvnode
# 웹 설정 페이지를 80번에서 연다
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
